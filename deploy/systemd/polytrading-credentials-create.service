[Unit]
Description=Create absent Polymarket CLOB credentials as encrypted systemd blobs
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=polytrading
Group=polytrading
UMask=0077
WorkingDirectory=/opt/polytrading
StateDirectory=polytrading
StateDirectoryMode=0700
LoadCredentialEncrypted=wallet-private-key:/var/lib/polytrading/credentials/wallet-private-key.cred
LoadCredential=systemd-credential-host-key:/var/lib/systemd/credential.secret
BindReadOnlyPaths=%d/systemd-credential-host-key:/var/lib/systemd/credential.secret
ExecStart=/opt/polytrading/.venv/bin/polytrading predictions pilot credentials create --confirm
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/polytrading/credentials
CapabilityBoundingSet=
