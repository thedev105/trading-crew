      "BUY_makerAmount_is_usd_and_takerAmount_is_shares",
      "SELL_makerAmount_is_shares_and_takerAmount_is_usd"
    ],
    "market_rules": [
      "price_and_input_amount_round_down_to_configured_decimals",
      "calculated_takerAmount_rounds_up_to_amount_decimals_plus_four_then_to_amount_decimals",
      "BUY_makerAmount_is_usd_and_takerAmount_is_usd_divided_by_maximum_price_shares",
      "SELL_makerAmount_is_shares_and_takerAmount_is_shares_times_minimum_price_usd"
    ]
